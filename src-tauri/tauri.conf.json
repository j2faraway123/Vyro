{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyro",
  "version": "0.3.0",
  "identifier": "app.vyro.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob: https://*.googleusercontent.com https://*.ggpht.com https://*.ytimg.com",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/artwork/**", "$APPDATA/backgrounds/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "category": "Music",
    "shortDescription": "A customizable desktop music player",
    "longDescription": "Vyro is an independent desktop music player with album-reactive backgrounds, a theme engine, synced lyrics and the optional Vyro Shield blocker for its web windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
